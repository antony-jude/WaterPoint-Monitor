{
  "buildCommand": "npm run build",
  "outputDirectory": "Source Code/frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "Source Code/backend/database.sqlite",
      "excludeFiles": "Source Code/backend/node_modules/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
